---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import WhatsApp from '../components/WhatsApp.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'DYGO Sistemas Digitais - Transformamos ideias em soluções digitais sob medida. Especialistas em desenvolvimento de software e consultoria.' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#1a1a1a" />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="DYGO, sistemas digitais, desenvolvimento de software, consultoria, soluções digitais, tecnologia, SPA, Astro" />
		<meta name="author" content="DYGO Sistemas Digitais" />
		<meta name="robots" content="index, follow" />

		<slot name="head" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<Navbar />
		<div class="h-16 md:h-20"></div>
		<slot />
		<WhatsApp />
	</body>
</html>
