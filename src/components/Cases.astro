---
const cases = [
  {
    client: 'Valiant Group do Brasil',
    type: 'Parceiro Principal',
    description: 'Transformação digital completa com integração de sistemas e otimização de processos.',
    year: '2024'
  }
];

const partners = [
  {
    name: 'Parceiro 1',
    description: 'Conexão através do Valiant Group'
  },
  {
    name: 'Parceiro 2',
    description: 'Conexão através do Valiant Group'
  },
  {
    name: 'Parceiro 3',
    description: 'Conexão através do Valiant Group'
  }
];

const featuredCase = cases[0];
---

<section id="cases" class="py-20 md:py-24 bg-grafite text-areia">
  <div class="max-w-6xl mx-auto px-6">
    <header class="section-heading grid gap-5 mb-14 md:mb-20">
      <p class="text-ambar text-xs font-semibold tracking-[0.2em] uppercase font-space-grotesk">
        Trabalho e colaboração
      </p>
      <div class="grid gap-5 md:grid-cols-2 md:items-end md:gap-12">
        <h2 class="text-3xl md:text-5xl font-bold font-space-grotesk leading-tight">
          Cases e <span class="text-ambar">Parceiros</span>
        </h2>
        <p class="text-areia/70 text-lg leading-relaxed md:max-w-lg md:justify-self-end">
          Conheça nossos cases de sucesso e parceiros estratégicos
        </p>
      </div>
    </header>

    <article class="featured-case border-y border-areia/20 py-8 md:py-12">
      <div class="case-layout grid gap-6 md:gap-10">
        <div class="flex items-start justify-between gap-6 md:block">
          <p class="text-ambar text-xs font-semibold tracking-[0.18em] uppercase font-space-grotesk">
            Case em destaque
          </p>
          <span class="text-areia/60 text-sm font-space-grotesk md:block md:mt-5">01 / {featuredCase.year}</span>
        </div>

        <div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-5">
            <span class="text-areia/65 text-sm font-space-grotesk">{featuredCase.type}</span>
            <span class="w-8 h-px bg-ambar" aria-hidden="true"></span>
            <span class="text-areia/65 text-sm font-space-grotesk">Transformação digital</span>
          </div>
          <h3 class="text-3xl md:text-5xl font-bold mb-5 font-space-grotesk leading-tight">
            {featuredCase.client}
          </h3>
          <p class="text-areia/80 text-lg md:text-xl leading-relaxed max-w-3xl">
            {featuredCase.description}
          </p>
        </div>
      </div>
    </article>

    <div class="mt-16 md:mt-20">
      <div class="flex items-end justify-between gap-6 mb-6">
        <div>
          <p class="text-ambar text-xs font-semibold tracking-[0.18em] uppercase mb-3 font-space-grotesk">
            Diretório
          </p>
          <h3 class="text-2xl md:text-3xl font-bold font-space-grotesk">Parceiros estratégicos</h3>
        </div>
        <p class="hidden sm:block text-areia/60 text-sm font-space-grotesk">
          {String(partners.length).padStart(2, '0')} relações ativas
        </p>
      </div>

      <ol class="partner-directory border-t border-areia/20">
        {partners.map((partner, index) => (
          <li class="partner-row grid gap-3 py-6 md:py-7 border-b border-areia/20 md:items-center">
            <span class="text-ambar text-sm font-space-grotesk" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h4 class="text-xl md:text-2xl font-bold font-space-grotesk">{partner.name}</h4>
            <span class="text-areia/65 text-sm font-space-grotesk">Parceiro estratégico</span>
            <p class="text-areia/75 leading-relaxed md:text-right">{partner.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .case-layout {
      grid-template-columns: minmax(9rem, 0.3fr) minmax(0, 1fr);
    }

    .partner-row {
      grid-template-columns: 3rem minmax(9rem, 0.8fr) minmax(8rem, 0.65fr) minmax(12rem, 1fr);
      column-gap: 2rem;
    }
  }
</style>
