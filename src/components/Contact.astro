---
---

<section id="contato" class="py-20 bg-areia">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-5xl font-bold text-grafite mb-4 font-space-grotesk">
        Entre em <span class="text-ambar">Contato</span>
      </h2>
      <p class="text-chumbo text-lg max-w-2xl mx-auto">
        Pronto para transformar seu negócio? Vamos conversar.
      </p>
    </div>

    <form 
      id="contact-form"
      class="bg-white rounded-2xl shadow-xl p-8 md:p-12"
      action="https://formsubmit.co/yuri.goliveira2@gmail.com"
      method="POST"
    >
      <!-- Configuração do FormSubmit -->
      <input type="hidden" name="_subject" value="Novo contato pelo site DYGO" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_template" value="table" />
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div>
          <label for="nome" class="block text-sm font-semibold text-grafite mb-2 font-space-grotesk">
            Nome *
          </label>
          <input 
            type="text" 
            id="nome" 
            name="nome" 
            required
            class="w-full px-4 py-3 border border-chumbo/20 rounded-lg focus:outline-none focus:border-ambar focus:ring-2 focus:ring-ambar/20 transition-all font-helvetica"
            placeholder="Seu nome completo"
          />
        </div>
        
        <div>
          <label for="email" class="block text-sm font-semibold text-grafite mb-2 font-space-grotesk">
            Email *
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required
            class="w-full px-4 py-3 border border-chumbo/20 rounded-lg focus:outline-none focus:border-ambar focus:ring-2 focus:ring-ambar/20 transition-all font-helvetica"
            placeholder="seu@email.com"
          />
        </div>
      </div>

      <div class="mb-6">
        <label for="empresa" class="block text-sm font-semibold text-grafite mb-2 font-space-grotesk">
          Empresa
        </label>
        <input 
          type="text" 
          id="empresa" 
          name="empresa"
          class="w-full px-4 py-3 border border-chumbo/20 rounded-lg focus:outline-none focus:border-ambar focus:ring-2 focus:ring-ambar/20 transition-all font-helvetica"
          placeholder="Nome da sua empresa"
        />
      </div>

      <div class="mb-6">
        <label for="assunto" class="block text-sm font-semibold text-grafite mb-2 font-space-grotesk">
          Assunto *
        </label>
        <select 
          id="assunto" 
          name="assunto" 
          required
          class="w-full px-4 py-3 border border-chumbo/20 rounded-lg focus:outline-none focus:border-ambar focus:ring-2 focus:ring-ambar/20 transition-all font-helvetica bg-white"
        >
          <option value="">Selecione um assunto</option>
          <option value="desenvolvimento">Desenvolvimento de Software</option>
          <option value="consultoria">Consultoria</option>
          <option value="integracao">Integração de Sistemas</option>
          <option value="suporte">Suporte Técnico</option>
          <option value="outro">Outro</option>
        </select>
      </div>

      <div class="mb-8">
        <label for="mensagem" class="block text-sm font-semibold text-grafite mb-2 font-space-grotesk">
          Mensagem *
        </label>
        <textarea 
          id="mensagem" 
          name="mensagem" 
          required
          rows="5"
          class="w-full px-4 py-3 border border-chumbo/20 rounded-lg focus:outline-none focus:border-ambar focus:ring-2 focus:ring-ambar/20 transition-all resize-none font-helvetica"
          placeholder="Descreva seu projeto ou necessidade..."
        ></textarea>
      </div>

      <button 
        type="submit"
        class="w-full bg-ambar text-grafite font-bold py-4 px-8 rounded-lg hover:bg-mel transition-colors duration-300 font-space-grotesk text-lg"
      >
        Enviar Mensagem
      </button>

      <p class="text-center text-chumbo text-sm mt-4">
        Responderemos em até 24 horas úteis.
      </p>
    </form>
  </div>
</section>
