    background: #FAC775;
    opacity: 0.4; /* Opacidade fixa e sutil */
    box-shadow: 
      20vw 10vh 0 #FAC775, 45vw 15vh 0 #FAC775, 70vw 5vh 0 #FAC775, 85vw 18vh 0 #FAC775,
      10vw 30vh 0 #FAC775, 35vw 25vh 0 #FAC775, 60vw 35vh 0 #FAC775, 90vw 28vh 0 #FAC775,
      5vw 50vh 0 #FAC775, 25vw 55vh 0 #FAC775, 50vw 48vh 0 #FAC775, 75vw 60vh 0 #FAC775,
      15vw 75vh 0 #FAC775, 40vw 70vh 0 #FAC775, 65vw 80vh 0 #FAC775, 80vw 85vh 0 #FAC775;
  }
</style>