---
import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import Footer from '../../components/Footer.astro';

interface Post {
  slug: string;
  title: string;
  excerpt: string;
  date: string;
  category: string;
  coverImage: string;
  readTime: string;
}

const postFiles = import.meta.glob('../../data/blog/*.json', { eager: true });

const posts: Post[] = Object.values(postFiles)
  .map((mod: any) => mod.default || mod)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

function formatDate(dateStr: string): string {
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('pt-BR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  });
}

const title = 'Blog | DYGO Sistemas Digitais';
const description = 'Artigos sobre desenvolvimento de software, tecnologia, processos ágeis e inovação digital pela DYGO Sistemas Digitais.';
---

<Layout title={title} description={description}>
  <SEO slot="head" title={title} description={description} jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description: description,
  }} />
  <main class="bg-grafite min-h-screen text-areia">
    <!-- Header -->
    <section class="pt-28 pb-16 px-6">
      <div class="max-w-6xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold font-space-grotesk mb-4">
          Blog <span class="text-ambar">DYGO</span>
        </h1>
        <p class="text-lg text-areia/70 font-helvetica max-w-2xl mx-auto">
          Insights sobre tecnologia, processos ágeis e estratégias digitais para impulsionar seu negócio.
        </p>
      </div>
    </section>

    <!-- Posts Grid -->
    <section class="pb-24 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="group block">
              <article class="bg-grafite border border-chumbo/30 rounded-xl overflow-hidden hover:border-ambar/50 transition-all duration-300 h-full flex flex-col">
                <div class="aspect-video bg-chumbo/30 overflow-hidden">
                  <img src={post.coverImage} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </div>
                <div class="p-6 flex flex-col flex-1">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="text-xs font-semibold text-ambar bg-ambar/10 px-3 py-1 rounded-full font-space-grotesk">
                      {post.category}
                    </span>
                    <span class="text-xs text-areia/50 font-helvetica">
                      {post.readTime} de leitura
                    </span>
                  </div>
                  <h2 class="text-xl font-bold font-space-grotesk mb-3 group-hover:text-ambar transition-colors duration-300 leading-snug">
                    {post.title}
                  </h2>
                  <p class="text-sm text-areia/60 font-helvetica leading-relaxed mb-4 flex-1">
                    {post.excerpt}
                  </p>
                  <div class="flex items-center justify-between pt-4 border-t border-chumbo/20">
                    <time class="text-xs text-areia/40 font-helvetica">
                      {formatDate(post.date)}
                    </time>
                    <span class="text-xs text-ambar font-space-grotesk group-hover:translate-x-1 transition-transform duration-300 inline-block">
                      Ler mais →
                    </span>
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
